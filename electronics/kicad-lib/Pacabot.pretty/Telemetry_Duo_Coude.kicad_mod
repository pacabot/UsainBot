(footprint "Telemetry_Duo_Coude"
	(version 20260206)
	(generator "pacabot-gen")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Station de telemetrie couchee : OPV302 (VCSEL 850 nm, TO-46) + BPV10NF (photodiode T-1 3/4), pattes cintrees a 90 deg, axes optiques horizontaux a 6.0 mm au-dessus de la carte, visee +X, entraxe 10.0 mm. Pads 1=TX K, 2=TX A, 3=RX K, 4=RX A (convention Device:LED / D_Photo) ; couper la broche 3 (NC) du TO-46. Percages du support pare-soleil mechanics/telemetry_duo.py : M2 central (visse par le dessous) + 2 pions dia 1.6 dont un decale (detrompeur). Face avant du pare-soleil a X=+8.0 : a placer au bord de carte ou en surplomb. Courtyard reduit a la colonne de pads derriere la face arriere du socle.")
	(tags "telemetry laser vcsel photodiode pare-soleil couche")
	(attr through_hole exclude_from_pos_files)
	(property "Reference" "REF**" (at 0 -10.5 0) (layer "F.SilkS")
