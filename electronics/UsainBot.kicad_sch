		(title "UsainBot - robot suiveur de ligne, epreuve Formule 1 TNRS")
		(date "2026-08-30")
		(rev "A")
		(company "Pacabot")
		(comment 1 "STM32H723ZGT6 - 12 voies de ligne - 2 ponts DRV8874 - pack 2S - chimie a definir")
		(comment 2 "Reglement Formule 1 v2.11 (2025) - carte 4 couches, assemblage JLCPCB")
	)
	(lib_symbols)
	(text "USB-C, chargeur elevateur BQ25887, pack 2S,\ncoupure generale, anti-inversion, buck 3,3 V, rail 3V3A"
		(exclude_from_sim no)
		(at 23 70 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "25b4e0e9-80ef-6630-643c-3229be387db3")
	)
	(text "Flash W25Q128 sur SPI3, module BLE a alimentation\ncommutee, embase ESC et puissance de turbine"
		(exclude_from_sim no)
		(at 213 174 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "36842624-8b20-1b49-d58b-885ba28a7cf1")
	)
	(text "Douze ITR8307 au pas de 10 mm, deux bancs d emetteurs\npulses, charges d emetteur sur le rail analogique"
		(exclude_from_sim no)
		(at 23 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "6f570f29-c132-ff64-1942-dbb90334b4d2")
	)
	(text "Douze temoins de presence de ligne sur PCA9685,\nun par capteur de la moustache, pilotes en PWM par I2C2"
		(exclude_from_sim no)
		(at 213 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "8acf6fc5-8560-31ba-427f-765d3b894c87")
	)
	(text "Les feuilles communiquent par etiquettes globales : chaque bloc se lit seul,\net le renommage d un signal se propage sans retoucher les entrees de feuille."
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "8e1c4a5d-3418-1f28-2521-ee478c4a9127")
	)
	(text "Deux VL53L1X sur languette sechable, voie analogique\nrapide a gauche, LSM6DSO sur SPI2"
		(exclude_from_sim no)
		(at 213 70 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "9090a022-94fe-b60a-5dca-103a42af0042")
	)
	(text "OLED I2C2, switch 5 directions, buzzer sur TIM17,\nbouton et jack de depart, temoins"
		(exclude_from_sim no)
		(at 213 122 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "92439136-aa76-9854-5f70-72735715496e")
	)
	(text "Deux DRV8874 en mode PWM, limitation de courant,\nconnecteurs moteur + encodeur, filtrage de quadrature"
		(exclude_from_sim no)
		(at 23 174 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "959f428c-46c4-88f8-2e7d-80caa006742d")
	)
	(text "STM32H723VGT6 en LQFP100, decouplage, quartz 25 MHz,\nreset, BOOT0, empreinte Tag-Connect SWD + SWO"
		(exclude_from_sim no)
		(at 23 122 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "a2dd27a7-3757-fc5d-45a8-3e4c64a86c54")
	)
	(text "Points ouverts :\n- Pack commun 2S : cellules, capacite, chimie et protection generale a definir.\n  La recharge BQ25887 reste inhibee jusqu a configuration et validation du firmware.\n- EMAX Bullet 12A EMX-SC-1873 sur VPACK brut : 12 A continu / 15 A pointe.\n  Montage vertical prototype : mesurer pads / epaisseur / continuites de masse.\n- STM32H723ZGT6 LQFP144 : ADC directs pour ligne, telemetrie et mesures moteur.\n- OPV302 et BPV10NF : pose manuelle dans leurs supports de station.\n- Routage a effectuer; valider cuivre de puissance, thermique et vibrations avant fabrication."
		(exclude_from_sim no)
		(at 20 288 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "b7b1fc3d-eca7-5848-c8ad-66f7710e5c05")
	)
