# macOS
.DS_Store

# KiCad — état local, sauvegardes automatiques, caches
*.kicad_prl
*.lck
*-backups/
fp-info-cache
*.kicad_pcb-bak
*.kicad_sch-bak
*-cache.lib
*.net

# Extension d'historique local KiCad (contient son propre dépôt git)
.history/

# FreeCAD — sauvegardes automatiques
*.FCBak
*.FCStd1
*.fcstd1

# Archive de téléchargement, redondante avec le dossier extrait du même nom
mechanics/battery-holder-4xaa-1.snapshot.1.zip

# Sorties de fabrication (à régénérer, pas à versionner)
gerbers/
*.gbr
*.drl
*.zip
!Mecanique/**/*.x_t

# Python
__pycache__/
*.pyc
venv/

# Sauvegardes de travail des scripts
*.bak*

# Journaux d'exécution des générateurs FreeCAD (régénérés à chaque export)
*.log

# Dossiers de revue électronique : scripts, rapports et résultats finaux sont
# versionnés. Restent sur disque les assemblages de contrôle (régénérables),
# les étapes intermédiaires et les copies de documents tiers — le dépôt est
# public, les rapports citent leurs sources par URL.
electronics/*-review/**/*.step
electronics/*-review/**/*.kicad_pcb
electronics/*-review/**/*.kicad_pro
electronics/*-review/schematic-svg/
electronics/*-review/**/*-proposed.json
electronics/*-review/**/*-validated.json
electronics/*-review/**/*-before.json
electronics/*-review/**/before.json
electronics/*-review/**/before-netlist.xml
electronics/*-review/**/erc-first.json
electronics/*-review/*sources/*.pdf
electronics/*-review/*sources/*.png
electronics/*-review/*sources/*.jpg
electronics/*-review/*sources/*.jpeg
electronics/*-review/*sources/*.webp
electronics/*-review/*sources/*.html
